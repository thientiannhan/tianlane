# ============================================================================
# TIANLANE — ZERO-COST ($0) PRODUCTION ENVIRONMENT TEMPLATE
# Architecture: Neon.tech (PostgreSQL) + Cloudflare R2 + Koyeb (512MB RAM) + Odoo MCP
# ============================================================================

# 1. Server Config (Koyeb / Render Free Tier: 512MB RAM)
PORT=8080

# 2. Database (Neon.tech PostgreSQL Free Tier: 1GB Storage, 100 CU-hours/month)
# IMPORTANT: Always use the "-pooler" connection string to prevent connection exhaustion
# and allow Neon Scale-to-Zero (Auto-suspend after 5 minutes of inactivity).
DATABASE_URL="postgresql://user:password@ep-cool-darkness-123456-pooler.ap-southeast-1.aws.neon.tech/tianlane?sslmode=require"

# 3. Object Storage (Cloudflare R2 Free Tier: 10GB Storage, Zero Egress Fee)
# Stateless Mandate: Never write user uploads to local container disk (/tmp or ./uploads).
# Backend issues S3-compatible Presigned PUT URLs so browsers upload directly to R2.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="tianlane-deliverables"
R2_PUBLIC_DOMAIN="https://pub-xxxxxxxx.r2.dev"

# 4. CORS & Frontend Origin (Cloudflare Workers / Pages)
FRONTEND_URL="https://tianlane.huynhthiennhancutehihi.workers.dev"
VITE_API_URL="https://tianlane.onrender.com"

# 5. Odoo External API / MCP Connection (Logistics TechHub Production Config)
ODOO_URL="https://support.logtechub.com"
ODOO_DB="bitnami_odoo"
ODOO_USERNAME="james.nhan"
ODOO_API_KEY="your_odoo_api_key_or_password"
ODOO_COMPANY_ID="1"
